<%- include ("../../views/partials/head.ejs"); %>

<body style="background-color: rgb(230, 230, 230);">
    <div class="row">
        <div class="col-3"></div>
        <h2 class="col-6">Produtividade por Ramal</h2>
        <div class="col-3"></div>
    </div>	
    <table class="table table-striped" id="tabela">
        <thead>
            <tr>
            <th scope="col">Ramal</th>
            <th scope="col">Tempo Falado</th>
            <th scope="col">TMA Total</th>
            <th scope="col">Efetuadas</th>
            <th scope="col">Atendidas</th>
            <th scope="col">N.A.</th>
            <th scope="col">Ocupadas</th>
            <th scope="col">Falhas</th>
            </tr>
        </thead>
        <tbody id="lista">		
            <%vendedores.forEach(v=>{%>
                <tr>
                    <td><%=v.ramal%></td>
                    <td><%=v.tempoTot%></td>
                    <td><%=v.tmaTot%></td>
                    <td><%=v.ligEfetuadas%></td>
                    <td><%=v.atendidas%></td>
                    <td><%=v.na%></td>
                    <td><%=v.ocupadas%></td>
                    <td><%=v.falhas%></td>
                </tr>
            <%})%>
        
        </tbody>
        </table>
	

	<%- include ("../../views/partials/footer.ejs"); %>
	
</body>
</html>