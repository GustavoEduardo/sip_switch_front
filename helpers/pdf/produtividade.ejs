<%- include ("../../views/partials/head.ejs"); %>
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">

<body style="background-color: rgb(230, 230, 230);">
    <div class="row">
        <div class="col-1"></div>
        <h3 class="col-6">Produtividade por Ramal</h3>
        <div class="col-3"></div>        
    </div>
    <div class="row">
        <div class="col">
            <p>Data: <%=agr%></p>
        </div>
    </div>
    <table class="table table-striped" id="tabela">
        <thead>
            <tr>
                <th onclick="ordenar('src')" id="src" scope="col">Ramal</th>
                <th scope="col">Tempo Ativo</th>
                <th scope="col" id="">TMA Ativo</th>
                <th scope="col" id="">TMA Receptivo</th>
                <th scope="col" id="">TMA Total</th>
                <th scope="col" id="">Recebidas</th>
                <th style="background-color: rgb(231, 231, 231);" scope="col" id="">Efetuadas</th>
                <th style="background-color: rgb(231, 231, 231);" scope="col" id="">Atendidas</th>
                <th style="background-color: rgb(231, 231, 231);" scope="col" id="">N.A.</th>
                <th style="background-color: rgb(231, 231, 231);" scope="col" id="">Ocupadas</th>
                <th style="background-color: rgb(231, 231, 231);" scope="col" id="">Falhas</th>
            </tr>
            </thead>
            <tbody id="lista">		
                <%vendedores.forEach(v=>{%>
                    <tr>
                        <td><%=v.ramal%></td>
                        <td><%=v.tempoTot%></td>
                        <td><%=v.tmaAtivo%></td>
                        <td><%=v.tmaReceptivo%></td>
                        <td><%=v.tmaTot%></td>
                        <td><%=v.ligRecebidas%></td>
                        <td><%=v.ligEfetuadas%></td>
                        <td><%=v.atendidas%></td>
                        <td><%=v.na%></td>
                        <td><%=v.ocupadas%></td>
                        <td><%=v.falhas%></td>
                    </tr>
                <%})%>
            
            </tbody>
        </table>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
	
</body>
</html>