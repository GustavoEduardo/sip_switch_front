
<%- include ("../partials/head.ejs"); %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<body style="background-color: rgba(230, 230, 230, 0.555);">
	<%- include ("../partials/header.ejs"); %>

	<div class="principal">
	<div class="painel">
		<br>
		<div>
			<div class="form-row">
			  <div class="col-6">
				<h1>&nbsp Relatório de Produtovidade</h1>
			  </div>
			  <div class="col-3">
				<h3>Resultado da Busca</h3>
				<span>Encontradas: </span><span id="encontradas"><%=totais.ligEfetuadas%></span><br>
				<span>Antendidas: </span><span id="atendidas"><%=totais.atendidas%></span><br>
				<span>NA: </span><span id="na"><%=totais.na%></span><br>
				<span>Ocupadas: </span><span id="ocupadas"><%=totais.ocupadas%></span><br>
				<span>Falhas: </span><span id="falhas"><%=totais.falhas%></span><br>
				</div>
				<div class="grafico-status col-2">
					<h5>Resultado em %</h5>
					<canvas id="statusLigacoes"></canvas>
				</div>
				<div class="statusLigacoes col-1"></div>
			</div>
		</div>

		<br>
		<hr>
		<div class="">
			<a class="btn btn-outline-success mb-2 mr-1" target="_blank" href=""><i class="fas fa-file-excel"></i> CSV</a>
			<a class="btn btn-outline-danger mb-2 mr-1" target="_blank" href=""><i class="fas fa-file-pdf"></i> PDF</a>
		</div>
		<nav class="navbar navbar-dark bg-secondary ">
			<form class="form-inline ml-auto" method="post" action="relatorios-vendedores">
				<b class="nav-item nav-link">Tempo mínimo: </b>
				<select class="form-control mr-2 mb-1" id="temp" name="tempMin" required>
					<option value="0">Todas</option>
					<option value="10">10s</option>
					<option value="20">20s</option>	
					<option value="30">30s</option>	
					<option value="60">60s</option>
					<option value="90">90s</option>
				</select>					
				<b class="nav-item nav-link">Período: </b>
				<input class="form-control mr-2 mb-1" type="date" value="<%=filtro.dtInit%>" id="dtInit"  name="dtInit" required>
				<input class="form-control mr-2 mb-1" type="date" value="<%=filtro.dtFim%>"  id="dtFim" name="dtFim" required>
				<b class="nav-item nav-link">Horário: </b>
				<input class="form-control mr-2 mb-1" type="time" value="<%=filtro.hrInit%>"  id="hrInit"  name="hrInit" required>
				<input class="form-control mr-3 mb-1" type="time" value="<%=filtro.hrFim%>" id="hrFim" name="hrFim" required>
	
			  <button class="btn btn-success my-2 my-sm-1 mb-1" type="submit">Buscar</button>
			</form>
		  </nav>
		<br>

		<table class="table table-striped" id="tabela">
			<thead>
			  <tr>
				<th scope="col">Ramal</th>
				<th scope="col">Tempo Falado</th>
				<th scope="col">TMA Total</th>
				<th scope="col">Efetuadas</th>
				<th scope="col">Atendidas</th>
				<th scope="col">N.A.</th>
				<th scope="col">Ocupadas</th>
				<th scope="col">Falhas</th>
			  </tr>
			</thead>
			<tbody id="lista">		
				<%vendedores.forEach(v=>{%>
					<tr>
						<td><%=v.ramal%></td>
						<td><%=v.tempoTot%></td>
						<td><%=v.tmaTot%></td>
						<td><%=v.ligEfetuadas%></td>
						<td><%=v.atendidas%></td>
						<td><%=v.na%></td>
						<td><%=v.ocupadas%></td>
						<td><%=v.falhas%></td>
					</tr>
				<%})%>
			
			</tbody>
		  </table>
		  
	</div>
	
	<div>
		
	  </div>
	</div>

	<%- include ("../partials/footer.ejs"); %>

	
	<script>
	var encontradas = document.getElementById("encontradas").innerHTML;
	var atendidas = document.getElementById('atendidas').innerHTML;
	var na = document.getElementById("na").innerHTML;
	var ocupadas = document.getElementById("ocupadas").innerHTML;
	var falhas = document.getElementById("falhas").innerHTML;

	// var encontradas = 241;
	// var atendidas = ((150 *100)/encontradas).toFixed(2);
	// var na = ((60 *100)/encontradas).toFixed(2);
	// var ocupadas = ((25 *100)/encontradas).toFixed(2);
	// var falhas = ((6 *100)/encontradas).toFixed(2);
		
		const labels = [
			'Atendidas',
			'Não Atendidas',
			'Ocupadas',
			'Falhas',
		];

		const data = {
			labels: labels,
			datasets: [{
			label: 'Status das Ligações',
			backgroundColor: ["#2E8B57","#4169E1","#D2691E","#B22222"],
			borderColor: '#B0C4DE',
			data: [atendidas,na,ocupadas,falhas],
			}]
		};

		const config = {
				type: 'pie',
				data: data,
				options: {
					responsive: true,
					plugins: {
						legend: {
							display: false,							
						}
					},
				}
			};
	</script>
	<script>
		const myChart = new Chart(
		  document.getElementById('statusLigacoes'),
		  config
		);
	</script>
	   
	
</body>
</html>