
<%- include ("../partials/head.ejs"); %>

<body style="background-color: rgb(230, 230, 230);">
	<%- include ("../partials/header.ejs"); %>

	
	<div class="container" style="background-color: rgb(226, 224, 224); margin-top: 5%; padding: 8px 8px 25px 8px; border: 1px solid rgb(173, 173, 173);">
			<h1>Cadastro de nova Mídia</h1>
			<hr>
			<form method="post" action="">
				<div class="form-group">
				<label for="exampleFormControlInput1">Nome</label>
				<input type="text" class="form-control" id="exampleFormControlInput1" name="nome" placeholder="Informa um nome para a nova mídia" required>
				</div>
				<div class="form-group">
					<label for="exampleFormControlInput2">Telefone</label>
					<input min="0" type="number" class="form-control" id="exampleFormControlInput2" name="telefone" placeholder="Ex: 0800300555" required>
					</div>			
				<div class="form-group">
				<label for="exampleFormControlTextarea1">Descrição</label>
				<textarea placeholder="Uma breve descrição pode ajudar na hora de identificar a mídia." name="descricao" class="form-control" id="exampleFormControlTextarea1" rows="3" required></textarea>
				</div>
				<button class="btn btn-lg btn-info" style="width: 100%;">Cadastrar</button>
			</form>
		 	</div>

		

	</div>

	

	<%- include ("../partials/footer.ejs"); %>
	
</body>
</html>