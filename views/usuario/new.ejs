
<%- include ("../partials/head.ejs"); %>

<body style="background-color: rgb(230, 230, 230);">
	<%- include ("../partials/header.ejs"); %>

	
	<div class="container" style="background-color: rgb(226, 224, 224); margin-top: 5%; padding: 8px 8px 25px 8px; border: 1px solid rgb(173, 173, 173);">
			<h1>Cadastro de novo Usuário</h1>
			<hr>
			<form method="post" action="usuario-cadastrar" onsubmit="confirmeSenha(event,this)">
				<div class="form-group">
					<label for="exampleFormControlInput1">Nome</label>
					<input type="text" class="form-control" id="exampleFormControlInput1" name="nome" required>
				</div>
				<div class="form-group">
					<label for="exampleFormControlInput2">Email</label>
					<input type="email" class="form-control" id="exampleFormControlInput2" name="email" required>
				</div>
				<div class="form-group">
					<label for="senha">Senha</label>
					<input type="password" class="form-control" id="senha" name="senha" required>
				</div>
				<div class="form-group">
					<label for="confirme">Confirme a Senha</label>
					<input type="password" class="form-control" id="confirme" required>
				</div>
				
				<button class="btn btn-lg btn-info" style="width: 100%;">Cadastrar</button>
			</form>
		 	</div>

		

	</div>
	<script>		
		function confirmeSenha(event, form){
			event.preventDefault();//não executa o evento.
			var senha = document.getElementById('senha').value;
			var confirme = document.getElementById('confirme').value;
			console.log(confirme)
			if(senha == confirme){
				form.submit();
			}else{
				alert("As senhas devem ser iguais")
			}
		}
	</script>

	<%- include ("../partials/footer.ejs"); %>
	
</body>
</html>