<script>  
  function getToken(){
    var tk = localStorage.getItem('token')    
    var len = document.getElementsByClassName("token").length;
    for (i = 0; i < len; i++){
      document.getElementsByClassName("token")[i].value = tk;				
    }
  }
  getToken()
</script>
