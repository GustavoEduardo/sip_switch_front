
<%- include ("partials/head.ejs"); %>

<body style="background-color: rgb(230, 230, 230);">
	<%- include ("partials/header.ejs"); %>

	<div class="principal">
	<div class="painel">
		<br>
		<form>
			<div class="form-row">
			  <div class="col">
				<h1>Atendimentos</h1>
			  </div>
			  <div class="col-4">
				<h3>Resultado da Busca</h3>
				<span>Encontradas: </span><span id="total"></span><br>
				<span>Anonimo: </span><span id="anonimo"></span><br>
				<span>Telefone: </span><span id="telefone"></span>
				<h6>Periodo</h6>
				<span>De: </span><span id="de"></span>&nbsp <span id="hrDe"></span><br>
				<span>Até: </span><span id="ate"></span>&nbsp <span id="hrAte"></span>
			  </div>
			</div>
		  </form>

		<br>
		<hr>
		<div class="botoes">
			<a class="btn btn-outline-success mb-2 ml-auto" target="_blank" href=""><i class="fas fa-file-excel"></i> Exportar</a>
		</div>
		<nav class="navbar navbar-dark bg-secondary ">
			<form class="form-inline ml-auto">
				<select class="form-control mr-2" id="tel">
					<option>Selecione o número</option>
					
				</select>
				<b class="nav-item nav-link">Período: &nbsp&nbsp </b>
				<input class="form-control mr-2" type="date" placeholder="Input padrão" id="dtInit">
				<input class="form-control mr-2" type="date" placeholder="Input padrão" id="dtFim">
				<b class="nav-item nav-link">Horário: &nbsp&nbsp </b>
				<input class="form-control mr-2" type="time" placeholder="Input padrão" id="hrInit">
				<input class="form-control mr-3" type="time" placeholder="Input padrão" id="hrFim">
	
			  <button class="btn btn-success my-2 my-sm-1" type="submit" onclick="buscarLigacoes()">Pesquisar</button>
			</form>
		  </nav>
		<br>

		<table class="table table-striped" id="tabela">
			<thead>
			  <tr>
				<th scope="col">Telefone</th>
				<th scope="col">Data</th>
				<th scope="col">Hora</th>
				<th scope="col">Duração</th>
			  </tr>
			</thead>
			<tbody id="lista">
			 
			
			</tbody>
		  </table>

	</div>
	</div>

	<%- include ("partials/footer.ejs"); %>
	<script type="text/javascript" src="/js/atendimentos.js"></script>

</body>
</html>