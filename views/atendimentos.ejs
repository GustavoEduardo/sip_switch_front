
<%- include ("partials/head.ejs"); %>

<body style="background-color: rgba(230, 230, 230, 0.555);">
	<%- include ("partials/header.ejs"); %>

	<div class="principal">
	<div class="painel">
		<br>
		<form>
			<div class="form-row">
			  <div class="col">
				<h1>&nbsp Ligações recebidas</h1>
			  </div>
			  <div class="col-4">
				<h3>Resultado da Busca</h3>
				<span>Encontradas: </span><span> <%=result.length%></span><br>
				<span>Anonimo: </span><span></span><br>
				<span>Telefone: </span><span id="telefone"><%=filtro.telefone%></span>
			</div>
			</div>
		  </form>

		<br>
		<hr>
		<div class="">
			<a class="btn btn-outline-success mb-2" target="_blank" href=""><i class="fas fa-file-excel"></i> CSV</a>
		</div>
		<nav class="navbar navbar-dark bg-secondary ">
			<form class="form-inline ml-auto" method="post" action="atendimentos-listar">
				<b class="nav-item nav-link">Mídia: </b>
				<select class="form-control mr-2 mb-1" id="tel" name="telefone" required>
					<option value="">---</option>
					<%midias.forEach(m=>{%>
						<option value="<%=m.telefone%>"><%=m.nome%></option>
					<%})%>								
				</select>
				<b class="nav-item nav-link">Período: </b>
				<input class="form-control mr-2 mb-1" type="date" value="<%=filtro.dtInit%>" id="dtInit"  name="dtInit" required>
				<input class="form-control mr-2 mb-1" type="date" value="<%=filtro.dtFim%>"  id="dtFim" name="dtFim" required>
				<b class="nav-item nav-link">Horário: </b>
				<input class="form-control mr-2 mb-1" type="time" value="<%=filtro.hrInit%>"  id="hrInit"  name="hrInit" required>
				<input class="form-control mr-3 mb-1" type="time" value="<%=filtro.hrFim%>" id="hrFim" name="hrFim" required>
	
			  <button class="btn btn-success my-2 my-sm-1 mb-1" type="submit">Buscar</button>
			</form>
		  </nav>
		<br>

		<table class="table table-striped" id="tabela">
			<thead>
			  <tr>
				<th scope="col">Telefone</th>
				<th scope="col">Data</th>
				<th scope="col">Hora</th>
				<th scope="col">Duração</th>
			  </tr>
			</thead>
			<tbody id="lista">
			 <%result.forEach(r=>{%>
				<tr>
					<td><%=r.src%></td>
					<td><%=r.data%></td>
					<td><%=r.hora%></td>
					<td><%=r.duration%></td>
				</tr>
			<%})%>
			
			</tbody>
		  </table>

	</div>
	</div>

	<%- include ("partials/footer.ejs"); %>
	
</body>
</html>